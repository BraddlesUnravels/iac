{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/braddlesunravels/iac/main/schemas/environment.schema.json",
  "title": "Azure IaC environment catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "name", "azure", "workloads"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "name": {
      "enum": ["dev", "test", "stage", "production"]
    },
    "azure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscriptionId",
        "tenantId",
        "location",
        "platformResourceGroup",
        "containerRegistryName",
        "containerRegistryLoginServer",
        "containerRegistryRoleAssignmentMode"
      ],
      "properties": {
        "subscriptionId": {
          "type": "string",
          "format": "uuid"
        },
        "tenantId": {
          "type": "string",
          "format": "uuid"
        },
        "location": {
          "enum": ["australiaeast"]
        },
        "platformResourceGroup": {
          "$ref": "#/$defs/resourceGroupName"
        },
        "containerRegistryName": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]{5,50}$"
        },
        "containerRegistryLoginServer": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9]{5,50}\\.azurecr\\.io$"
        },
        "containerRegistryRoleAssignmentMode": {
          "const": "AbacRepositoryPermissions"
        }
      }
    },
    "workloads": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/workloadTarget"
      }
    }
  },
  "$defs": {
    "azureResourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._()-]*$"
    },
    "resourceGroupName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 90,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._()-]*[a-zA-Z0-9_()-]$"
    },
    "identityName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9-_]+$"
    },
    "keyVaultName": {
      "type": "string",
      "minLength": 3,
      "maxLength": 24,
      "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$"
    },
    "secretName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 127,
      "pattern": "^[0-9a-zA-Z-]+$"
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetPorts",
        "minReplicas",
        "maxReplicas",
        "healthProbePaths",
        "cpu",
        "memory"
      ],
      "properties": {
        "targetPorts": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "minReplicas": {
          "$ref": "#/$defs/integerRange"
        },
        "maxReplicas": {
          "$ref": "#/$defs/integerRange"
        },
        "healthProbePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/[^?#]*$"
          }
        },
        "cpu": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["0.25", "0.5", "0.75", "1.0", "1.25", "1.5", "1.75", "2.0"]
          }
        },
        "memory": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?:0\\.5|[1-9][0-9]*(?:\\.0)?)Gi$"
          }
        }
      }
    },
    "integerRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {
          "type": "integer",
          "minimum": 0
        },
        "maximum": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workloadTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceGroup",
        "stack",
        "repository",
        "repositoryId",
        "repositoryOwnerId",
        "containerRepository",
        "containerAppsEnvironmentName",
        "containerAppName",
        "logAnalyticsWorkspaceName",
        "keyVaultName",
        "runtimeIdentityName",
        "publisherIdentityName",
        "plannerIdentityName",
        "deployerIdentityName",
        "customDomainName",
        "certificateResourceId",
        "allowedSecretNames",
        "migrationSecretNames",
        "externalEnvironmentVariables",
        "bounds"
      ],
      "properties": {
        "resourceGroup": {
          "$ref": "#/$defs/resourceGroupName"
        },
        "stack": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "repositoryId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "repositoryOwnerId": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "containerRepository": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._/-][a-z0-9]+)*$"
        },
        "containerAppsEnvironmentName": {
          "$ref": "#/$defs/azureResourceName"
        },
        "containerAppName": {
          "$ref": "#/$defs/azureResourceName"
        },
        "logAnalyticsWorkspaceName": {
          "$ref": "#/$defs/azureResourceName"
        },
        "keyVaultName": {
          "anyOf": [
            {
              "$ref": "#/$defs/keyVaultName"
            },
            {
              "type": "null"
            }
          ]
        },
        "runtimeIdentityName": {
          "$ref": "#/$defs/identityName"
        },
        "publisherIdentityName": {
          "$ref": "#/$defs/identityName"
        },
        "plannerIdentityName": {
          "$ref": "#/$defs/identityName"
        },
        "deployerIdentityName": {
          "$ref": "#/$defs/identityName"
        },
        "customDomainName": {
          "anyOf": [
            {
              "type": "string",
              "format": "hostname"
            },
            {
              "type": "null"
            }
          ]
        },
        "certificateResourceId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.App/managedEnvironments/[^/]+/(?:managedCertificates|certificates)/[^/]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "additionalCustomDomains": {
          "type": "array",
          "default": [],
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "certificateResourceId"],
            "properties": {
              "name": {
                "type": "string",
                "format": "hostname"
              },
              "certificateResourceId": {
                "type": "string",
                "pattern": "^/subscriptions/[0-9a-fA-F-]{36}/resourceGroups/[^/]+/providers/Microsoft\\.App/managedEnvironments/[^/]+/(?:managedCertificates|certificates)/[^/]+$"
              }
            }
          }
        },
        "allowedSecretNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/secretName"
          }
        },
        "migrationSecretNames": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/secretName"
          }
        },
        "externalEnvironmentVariables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]*$"
          }
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        }
      }
    }
  }
}