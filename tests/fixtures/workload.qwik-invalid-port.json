{
  "$schema": "../../schemas/workload.schema.json",
  "schemaVersion": 1,
  "application": "qwik-website",
  "stack": "single-container-web",
  "environment": "production",
  "container": {
    "targetPort": 4000,
    "healthProbePath": "/health",
    "cpu": "0.25",
    "memory": "0.5Gi",
    "minReplicas": 1,
    "maxReplicas": 1
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "HOST": "0.0.0.0",
    "ACA_DEMO_DOMAIN": "https://aca.braddlesunravels.online",
    "ACA_DEMO_ACCESS_LINK": "{{ACA_DEMO_DOMAIN}}/?code={{ACA_GENERAL_ACCESS_CODE}}"
  },
  "secretRefs": {
    "ACA_GENERAL_ACCESS_CODE": "qwik-demo-general-access-code"
  },
  "customDomain": {
    "enabled": true
  }
}
