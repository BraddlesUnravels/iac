{
  "$schema": "../../schemas/workload.schema.json",
  "schemaVersion": 1,
  "application": "access-control-demo",
  "stack": "qwik-elysia-postgres",
  "environment": "production",
  "container": { "targetPort": 3000, "healthProbePath": "/api/health", "cpu": "0.25", "memory": "0.5Gi", "minReplicas": 1, "maxReplicas": 1 },
  "env": { "NODE_ENV": "production", "NEXT_TELEMETRY_DISABLED": "1", "HOSTNAME": "0.0.0.0", "PORT": "3000", "ACCESS_GATE_DISABLED": "false" },
  "secretRefs": { "ACCESS_GATE_CODE_SECRET": "access-gate-code-secret", "ACCESS_GATE_COOKIE_SECRET": "access-gate-cookie-secret" },
  "customDomain": { "enabled": true }
}